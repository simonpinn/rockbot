@page "/consciousness"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using RockBot.UserProxy
@using RockBot.UserProxy.Blazor.Services
@inject ReflexActivityStateService Feed
@inject UserProxyService ProxyService
@implements IDisposable

<PageTitle>Reflex activity</PageTitle>

<div class="chat-container d-flex flex-column">
    <div class="chat-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-baseline gap-2">
            <h1 class="h4 mb-0">Reflex activity</h1>
            <span class="small opacity-75">a view onto what is effectively a background consciousness</span>
        </div>
        <a class="btn btn-sm btn-outline-light" href="/">Back to chat</a>
    </div>

    <div class="p-3 border-bottom bg-light">
        <h2 class="h6">Dream cycle</h2>
        <div class="d-flex align-items-center gap-2 mb-2">
            <button class="btn btn-sm btn-outline-primary" @onclick="RunFullCycleAsync" disabled="@_cycleBusy">
                Run full cycle now
            </button>
            @if (_fullCycleOutcome is not null)
            {
                <span class="small text-muted">@_fullCycleOutcome</span>
            }
        </div>

        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-0">Target shape hash(es), comma-separated</label>
                <input class="form-control form-control-sm" style="width: 22rem" @bind="_targetShapeHashes" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Description contains</label>
                <input class="form-control form-control-sm" style="width: 16rem" @bind="_descriptionContains" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Operator hint</label>
                <input class="form-control form-control-sm" style="width: 22rem" @bind="_operatorHint" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-primary" @onclick="RunWispAnalysisAsync" disabled="@_cycleBusy">
                    Run wisp analysis now
                </button>
            </div>
        </div>
        @if (_wispAnalysisOutcome is not null)
        {
            <p class="small text-muted mt-2 mb-0">@_wispAnalysisOutcome</p>
        }
    </div>

    <div class="flex-grow-1 overflow-auto p-3">
        @if (Feed.Events.Count == 0)
        {
            <p class="text-muted">No reflex has fired yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Tool</th>
                        <th>Trigger</th>
                        <th>X-factor</th>
                        <th>Result</th>
                        <th>Duration</th>
                        <th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Feed.Events)
                    {
                        <tr class="@(evt.Succeeded ? "" : "table-danger")">
                            <td>@evt.FiredAt.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td><code>@evt.ToolName</code></td>
                            <td>
                                @if (evt.Trigger == "stimulus")
                                {
                                    <span class="badge bg-info" title="@evt.StimulusPatternId">stimulus</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary" title="@evt.SessionId">llm</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @if (evt.XFactor is not null)
                                {
                                    @($"[{evt.XFactor.Channel}] \"{evt.XFactor.Value}\" (w={evt.XFactor.SalienceWeight:F2})")
                                }
                            </td>
                            <td>@(evt.Succeeded ? "✅" : "❌")</td>
                            <td>@(evt.DurationMs) ms</td>
                            <td class="text-muted small">@evt.ErrorMessage</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private Action? _stateChangedHandler;
    private bool _cycleBusy;
    private string? _fullCycleOutcome;
    private string? _wispAnalysisOutcome;
    private string _targetShapeHashes = "";
    private string _descriptionContains = "";
    private string _operatorHint = "";

    protected override void OnInitialized()
    {
        _stateChangedHandler = () => InvokeAsync(StateHasChanged);
        Feed.OnStateChanged += _stateChangedHandler;
    }

    private async Task RunFullCycleAsync()
    {
        _cycleBusy = true;
        _fullCycleOutcome = null;
        try
        {
            var response = await ProxyService.TriggerDreamCycleAsync();
            _fullCycleOutcome = response is null
                ? "No response (timed out or agent unavailable)."
                : $"{response.Outcome} — a full cycle can take tens of minutes; watch the reflex activity feed and agent logs.";
        }
        finally
        {
            _cycleBusy = false;
        }
    }

    private async Task RunWispAnalysisAsync()
    {
        _cycleBusy = true;
        _wispAnalysisOutcome = null;
        try
        {
            var targets = _targetShapeHashes
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            var request = new WispAnalysisTriggerRequestMessage
            {
                TargetShapeHashes = targets.Length > 0 ? targets : null,
                DescriptionContains = string.IsNullOrWhiteSpace(_descriptionContains) ? null : _descriptionContains,
                OperatorHint = string.IsNullOrWhiteSpace(_operatorHint) ? null : _operatorHint,
            };

            var response = await ProxyService.TriggerWispAnalysisAsync(request);
            _wispAnalysisOutcome = response is null
                ? "No response (timed out or agent unavailable)."
                : response.Ran
                    ? $"Ran — {response.CandidatesAttached} candidate(s) attached; provisional validation: " +
                      $"{response.ProvisionalPromoted} promoted, {response.ProvisionalFlaggedForRepair} flagged for repair, " +
                      $"{response.ProvisionalRemoved} removed, {response.ProvisionalMarkedStale} marked stale " +
                      $"({response.ProvisionalConsidered} considered)."
                    : $"Did not run: {response.SkippedReason}";
        }
        finally
        {
            _cycleBusy = false;
        }
    }

    public void Dispose()
    {
        if (_stateChangedHandler is not null)
            Feed.OnStateChanged -= _stateChangedHandler;
    }
}
